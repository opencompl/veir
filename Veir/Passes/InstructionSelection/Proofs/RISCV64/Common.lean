/-! Shared imports for the RISC-V 64-bit instruction-selection validity proofs. -/

namespace Veir

-- Realize enum encodings once, so sibling proof modules share the declarations
-- generated by `veir_bv_decide` instead of exporting conflicting copies.
run_meta do
  for enumType in [``GMIR, ``GMIR_RISCV, ``IntegerType.Signedness, ``Data.LLVM.IntPred] do
    discard <| Lean.Meta.Tactic.BVDecide.Normalize.getEnumToBitVecFor enumType
    discard <| Lean.Meta.Tactic.BVDecide.Normalize.getEqIffEnumToBitVecEqFor enumType
    discard <| Lean.Meta.Tactic.BVDecide.Normalize.getEnumToBitVecLeFor enumType

/-- A signed twelve-bit immediate round-trips through its instruction field. -/
theorem mkRISCVImm_signExtend_12 (value : Int)
    (lo : -2048 ≤ value.bmod (2 ^ 64)) (hi : value.bmod (2 ^ 64) ≤ 2047) :
    ((mkRISCVImm value).immField 12).signExtend 64 = BitVec.ofInt 64 value := by
  have hlo : (-2048#64).sle (BitVec.ofInt 64 value) := by
    simpa [BitVec.sle_iff_toInt_le] using lo
  have hhi : (BitVec.ofInt 64 value).sle 2047#64 := by
    simpa [BitVec.sle_iff_toInt_le] using hi
  simp only [mkRISCVImm, RISCVImmediateProperties.immField]
  generalize BitVec.ofInt 64 value = bits at hlo hhi ⊢
  veir_bv_decide

private theorem query_icmp (q : LegalityQuery (GMIR.propertiesOf .g_icmp))
    (h : riscv64LegalizerInfo.getActionFor .g_icmp q = .legal) :
    q.getLLT! (.type 0) = .scalar 64 ∧
      (q.getLLT! (.type 1) = .scalar 64 ∨ q.getLLT! (.type 1) = .pointer 0) := by
  change (([LegalizeRule.legalForTypePairs [(.scalar 64, .scalar 64), (.scalar 64, .pointer 0)],
    LegalizeRule.minScalar (.type 1) 64, LegalizeRule.minScalar (.type 0) 64]).findSome? (· q)).getD .unsupported = .legal at h
  simp only [List.findSome?_cons, LegalizeRule.legalForTypePairs, LegalizeRule.legalIf,
    List.contains_cons, List.contains_nil, Bool.or_false] at h
  split at h
  · rename_i ht
    simp_all only [Bool.or_eq_true, beq_iff_eq, Prod.mk.injEq]
    grind
  · simp only [LegalizeRule.minScalar, LegalizeRule.widenScalarIf] at h
    repeat' split at h <;> simp_all

private theorem legal_icmp_llt (dst src : TypeAttr) (props : GMIR.propertiesOf .g_icmp)
    (h : riscv64LegalizerInfo.isLegal .g_icmp #[dst, src] props = true) :
    LLT.ofType? dst = some (.scalar 64) ∧
      (LLT.ofType? src = some (.scalar 64) ∨ LLT.ofType? src = some (.pointer 0)) := by
  unfold LegalizerInfo.isLegal at h
  cases hq : LegalityQuery.ofTypes? #[dst, src] props with
  | none => simp [hq] at h
  | some q =>
    simp only [hq] at h
    have hlegal : riscv64LegalizerInfo.getActionFor .g_icmp q = .legal := by
      split at h <;> simp_all
    have htypes := query_icmp q hlegal
    cases hd : LLT.ofType? dst <;> cases hs : LLT.ofType? src <;>
      simp [LegalityQuery.ofTypes?, Array.mapM, ↓Array.mapM.map, hd, hs] at hq
    cases hq
    simpa [LegalityQuery.getLLT!] using htypes

private theorem query_select (q : LegalityQuery (GMIR.propertiesOf .g_select))
    (h : riscv64LegalizerInfo.getActionFor .g_select q = .legal) :
    (q.getLLT! (.type 0) = .scalar 64 ∨ q.getLLT! (.type 0) = .pointer 0) ∧
      q.getLLT! (.type 1) = .scalar 64 := by
  change (([LegalizeRule.legalForTypePairs [(.scalar 64, .scalar 64), (.pointer 0, .scalar 64)],
    LegalizeRule.minScalar (.type 0) 64, LegalizeRule.minScalar (.type 1) 64]).findSome? (· q)).getD .unsupported = .legal at h
  simp only [List.findSome?_cons, LegalizeRule.legalForTypePairs, LegalizeRule.legalIf,
    List.contains_cons, List.contains_nil, Bool.or_false] at h
  split at h
  · rename_i ht
    simp_all only [Bool.or_eq_true, beq_iff_eq, Prod.mk.injEq]
    grind
  · simp only [LegalizeRule.minScalar, LegalizeRule.widenScalarIf] at h
    repeat' split at h <;> simp_all

private theorem legal_select_llt (dst src : TypeAttr) (props : GMIR.propertiesOf .g_select)
    (h : riscv64LegalizerInfo.isLegal .g_select #[dst, src] props = true) :
    (LLT.ofType? dst = some (.scalar 64) ∨ LLT.ofType? dst = some (.pointer 0)) ∧
      LLT.ofType? src = some (.scalar 64) := by
  unfold LegalizerInfo.isLegal at h
  cases hq : LegalityQuery.ofTypes? #[dst, src] props with
  | none => simp [hq] at h
  | some q =>
    simp only [hq] at h
    have hlegal : riscv64LegalizerInfo.getActionFor .g_select q = .legal := by
      split at h <;> simp_all
    have htypes := query_select q hlegal
    cases hd : LLT.ofType? dst <;> cases hs : LLT.ofType? src <;>
      simp [LegalityQuery.ofTypes?, Array.mapM, ↓Array.mapM.map, hd, hs] at hq
    cases hq
    simpa [LegalityQuery.getLLT!] using htypes

private theorem type_of_scalar64 (type : TypeAttr) (h : LLT.ofType? type = some (.scalar 64)) :
      ∃ s, type = TypeAttr.of IntegerType ⟨64, s⟩ := by
  rcases type with ⟨attr, hattr⟩
  cases attr <;> simp only [LLT.ofType?, Option.some.injEq, reduceCtorEq, LLT.scalar.injEq] at h
  rename_i integer
  rcases integer with ⟨w, s⟩
  cases h
  exact ⟨s, rfl⟩

private theorem type_of_pointer0 (type : TypeAttr) (h : LLT.ofType? type = some (.pointer 0)) :
      ∃ p : LLVM.PointerType, p.addressSpace = 0 ∧ type = TypeAttr.of LLVM.PointerType p := by
  rcases type with ⟨attr, hattr⟩
  cases attr <;> simp only [LLT.ofType?, Option.some.injEq, reduceCtorEq, LLT.pointer.injEq] at h
  rename_i p
  exact ⟨p, h, rfl⟩

theorem isLegal_g_icmp_types (dst src : TypeAttr) (props : GMIR.propertiesOf .g_icmp)
    (h : riscv64LegalizerInfo.isLegal .g_icmp #[dst, src] props = true) :
    (∃ s, dst = TypeAttr.of IntegerType ⟨64, s⟩) ∧
      ((∃ s, src = TypeAttr.of IntegerType ⟨64, s⟩) ∨
        (∃ p : LLVM.PointerType, p.addressSpace = 0 ∧ src = TypeAttr.of LLVM.PointerType p)) := by
  obtain ⟨hd, hs | hs⟩ := legal_icmp_llt dst src props h
  · exact ⟨type_of_scalar64 dst hd, .inl (type_of_scalar64 src hs)⟩
  · exact ⟨type_of_scalar64 dst hd, .inr (type_of_pointer0 src hs)⟩

theorem isLegal_g_select_types (dst cond : TypeAttr) (props : GMIR.propertiesOf .g_select)
    (h : riscv64LegalizerInfo.isLegal .g_select #[dst, cond] props = true) :
    ((∃ s, dst = TypeAttr.of IntegerType ⟨64, s⟩) ∨
      (∃ p : LLVM.PointerType, p.addressSpace = 0 ∧ dst = TypeAttr.of LLVM.PointerType p)) ∧
      (∃ s, cond = TypeAttr.of IntegerType ⟨64, s⟩) := by
  obtain ⟨hd | hd, hc⟩ := legal_select_llt dst cond props h
  · exact ⟨.inl (type_of_scalar64 dst hd), type_of_scalar64 cond hc⟩
  · exact ⟨.inr (type_of_pointer0 dst hd), type_of_scalar64 cond hc⟩

end Veir
