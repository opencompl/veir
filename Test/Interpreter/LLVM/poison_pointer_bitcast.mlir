// RUN: veir-interpret %s | filecheck %s

// Bitcasting a poison pointer to an `llvm.byte` gives a byte whose every bit
// is poison.

"builtin.module"() ({
  "llvm.func"() <{sym_name = "main", function_type = !llvm.func<!llvm.byte<64> ()>}> ({
    %p = "llvm.mlir.poison"() : () -> !llvm.ptr
    %byte = "llvm.bitcast"(%p) : (!llvm.ptr) -> !llvm.byte<64>
    "llvm.return"(%byte) : (!llvm.byte<64>) -> ()
  }) : () -> ()
}) : () -> ()

// CHECK: Program output: #[0b????????????????????????????????????????????????????????????????#64]
