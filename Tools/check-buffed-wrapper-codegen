#!/usr/bin/env python3
"""Check that `buffed` keeps the historical inventory without generating inners."""
import pathlib
import re
import subprocess

root = pathlib.Path(__file__).resolve().parent.parent
rows = [line.split("\t") for line in
        (root / "Tools/buffed-declarations.tsv").read_text().splitlines()
        if line and not line.startswith("#")]
assert len(rows) == 201, "retained buffed inventory changed unexpectedly"

for file, declaration, _, inline in rows:
    text = (root / file).read_text()
    pattern = (rf"\bbuffed\s+\(inline\s*:=\s*{inline}\)\s+def\s+"
               rf"{re.escape(declaration)}Sim(?=[\s({{:])")
    assert len(re.findall(pattern, text)) == 1, (
        f"missing historical declaration: {file}: {declaration}"
    )

subprocess.run(
    ["lake", "build", "UnitTest.Buffed:c.o", "UnitTest.BuffedAdoption"],
    cwd=root,
    check=True,
)
source = (root / ".lake/build/ir/UnitTest/Buffed.c").read_text()
for name in (
    "address", "keepPointer", "context", "count", "stride", "advance",
    "partialWalk", "partialPointer", "contextResult",
):
    assert f"{name}Inner" not in source, f"buffed still generated {name}Inner"

print("Buffed compatibility codegen passed: inline choices preserved and no inner implementations generated.")
