#!/usr/bin/env python3
"""VeIR compiler driver.

Compiles a C source file via VeIR, producing an executable by default. Code is
generated by VeIR's RISC-V backend unless --llvm-backend is given.
"""

from __future__ import annotations

import argparse
import math
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from mir_llc import emit_asm_cmd, regalloc_cmd


BASE_TOOLS = ("clang", "opt", "mlir-translate", "mlir-opt")
VEIR_TOOLS = ("lake",)
VEIR_BACKEND_TOOLS = ("llc",)
REPO_ROOT = Path(__file__).resolve().parent.parent
BIN_DIR = REPO_ROOT / ".lake" / "build" / "bin"
# Use the Linux hard-float ABI and all extensions VeIR's instruction selector
# can emit (see MIRPrinter.lean). Keep clang and both llc stages in sync.
RISCV_TRIPLE = "riscv64-unknown-linux-gnu"
RISCV_ABI = "lp64d"
RISCV_BASE_EXTENSIONS = "mafdc"
RISCV_EXTENSIONS = ("zicsr", "zifencei", "zba", "zbb", "zbs", "zbc", "zbkb", "zicond")
RISCV_MARCH = "rv64i" + RISCV_BASE_EXTENSIONS + "_" + "_".join(RISCV_EXTENSIONS)
RISCV_FEATURES = ",".join(f"+{ext}" for ext in (*RISCV_BASE_EXTENSIONS, *RISCV_EXTENSIONS))
CLANG_TARGET_FLAGS = [f"--target={RISCV_TRIPLE}", f"-march={RISCV_MARCH}",
                      f"-mabi={RISCV_ABI}", "-fomit-frame-pointer"]
LLC_TARGET_FLAGS = (f"-mtriple={RISCV_TRIPLE}", f"-mattr={RISCV_FEATURES}",
                    f"-target-abi={RISCV_ABI}")
# On Linux clang finds the riscv64 cross sysroot by itself; elsewhere (macOS)
# RISCV_SYSROOT names a copy of it.
if "RISCV_SYSROOT" in os.environ:
    CLANG_TARGET_FLAGS.append(f"--sysroot={os.environ['RISCV_SYSROOT']}")
# Where --veir-stats appends a line for each run of a VeIR executable.
VEIR_STATS: Path | None = None

def check_tools(tools: tuple[str, ...]) -> None:
    missing = [t for t in tools if shutil.which(t) is None]
    if missing:
        sys.exit(f"vcc: required tool(s) not found in PATH: {', '.join(missing)}")


def build_veir_tools(tools: tuple[str, ...]) -> None:
    """Bring VeIR's executables up to date, so that they can be run directly:
    each run of Lake costs about a second of CPU time, even with nothing to do."""
    # Lake reports build errors on stdout.
    result = subprocess.run(["lake", "build", *tools], cwd=REPO_ROOT, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    if result.returncode != 0:
        sys.exit(f"vcc: lake build failed:\n{result.stdout}")


def run(cmd: list[str], *, stdin: bytes | None = None, debug: bool = False) -> bytes:
    if debug:
        print(f"+ vcc.run: {' '.join(cmd)}", file=sys.stderr)
    result = subprocess.run(cmd, input=stdin, capture_output=True)
    if result.returncode != 0:
        err = result.stderr.decode("utf-8", errors="replace")
        if cmd[0] == "clang" and not riscv_sysroot_found():
            err += MISSING_SYSROOT_HINT
        sys.exit(f"vcc: {cmd[0]} failed:\n{err}")
    return result.stdout


def run_veir(cmd: list[str], *, debug: bool = False) -> bytes:
    """Run a VeIR executable whose last argument is its input file, recording
    the input's size and the time taken, even if the command fails."""
    start = time.perf_counter()
    try:
        return run(cmd, debug=debug)
    finally:
        if VEIR_STATS is not None:
            elapsed = time.perf_counter() - start
            size = os.path.getsize(cmd[-1])
            name = " ".join([Path(cmd[0]).name, *(a for a in cmd[1:-1] if a.startswith("-p="))])
            with VEIR_STATS.open("a") as stats:
                stats.write(f"{size}\t{elapsed:.3f}\t{name}\n")


MISSING_SYSROOT_HINT = """
vcc: clang cannot find a riscv64 Linux sysroot, so it falls back to the host's
headers and libraries. See "Setting up a RISC-V user-mode environment" in
README.md.
"""


def riscv_sysroot_found() -> bool:
    # clang prints the bare file name when it can't locate the file in the
    # target's sysroot.
    result = subprocess.run(["clang", *CLANG_TARGET_FLAGS, "-print-file-name=crt1.o"],
                            capture_output=True, stdin=subprocess.DEVNULL)
    return result.returncode == 0 and os.path.isabs(result.stdout.decode().strip())


def compile_to_mlir(src: Path, veir_optimize: bool, llvm_o2: bool, debug: bool = False) -> bytes:
    with tempfile.TemporaryDirectory(delete=not debug) as tmpdir:
        tmp = Path(tmpdir)
        bc = tmp / (src.stem + ".bc")
        bc_opt = tmp / (src.stem + "-opt.bc")

        run(["clang", *CLANG_TARGET_FLAGS, "-O0", "-Xclang", "-disable-O0-optnone", "-c", "-emit-llvm",
             str(src), "-o", str(bc)], debug=debug)
        if llvm_o2:
            # Run the full LLVM middle-end optimization pipeline, minus
            # autovectorization.
            run(["opt", "-O2", "-vectorize-loops=false", "-vectorize-slp=false",
                 str(bc), "-o", str(bc_opt)], debug=debug)
        else:
            # TODO -- as soon as we have our own mem2reg, stop running LLVM's
            run(["opt", "-passes=sroa", str(bc), "-o", str(bc_opt)], debug=debug)
        translated = run(["mlir-translate", "--import-llvm", str(bc_opt)], debug=debug)
        mlir = run(
            ["mlir-opt", "--mlir-print-op-generic", "--mlir-print-local-scope"],
            stdin=translated,
            debug=debug
        )
        pre = tmp / (src.stem + ".mlir")
        pre.write_bytes(mlir)
        opt_cmd = [str(BIN_DIR / "veir-opt"), "--allow-unregistered-dialect"]
        if veir_optimize:
            opt_cmd.append("-p=instcombine,dce,cse,dce")
        opt_cmd.append(str(pre))
        return run_veir(opt_cmd, debug=debug)


def translate_mlir_to_llvm(mlir: bytes, src_stem: str, debug: bool = False) -> bytes:
    with tempfile.TemporaryDirectory() as tmpdir:
        path = Path(tmpdir) / (src_stem + ".mlir")
        path.write_bytes(mlir)
        return run(["mlir-translate", "--mlir-to-llvmir", str(path)], debug=debug)


def write_output(output: bytes, dst: Path | None) -> None:
    if dst is None:
        sys.stdout.buffer.write(output)
    else:
        dst.write_bytes(output)


def veir_backend_to_asm(mlir: bytes, src_stem: str, debug: bool = False) -> bytes:
    """Lower LLVM-dialect MLIR to RISC-V assembly with VeIR's backend:
    instruction selection (veir-opt -p=riscv), MIR printing (veir2mir), then
    register allocation and assembly printing in llc."""
    with tempfile.TemporaryDirectory(delete=not debug) as tmpdir:
        tmp = Path(tmpdir)
        pre = tmp / (src_stem + ".mlir")
        pre.write_bytes(mlir)
        rv = tmp / (src_stem + ".riscv.mlir")
        rv.write_bytes(run_veir([str(BIN_DIR / "veir-opt"), "--allow-unregistered-dialect",
                                 "-p=riscv", str(pre)], debug=debug))
        mir = tmp / (src_stem + ".mir")
        mir_bytes = run_veir([str(BIN_DIR / "veir2mir"), str(rv)], debug=debug)
        # Function attributes override llc's -mattr. The standalone MIR printer
        # uses an integer-only target; give vcc's MIR the full Linux target too.
        mir.write_bytes(re.sub(rb'"target-features"="[^"]*"',
                               f'"target-features"="{RISCV_FEATURES}"'.encode(), mir_bytes))
        unhandled = mir.read_bytes().count(b"UNHANDLED")
        if unhandled:
            where = f"see {mir}" if debug else "rerun with --debug to keep the MIR"
            sys.exit(f"vcc: VeIR's RISC-V backend could not lower {unhandled} operation(s) "
                     f"({where})")
        lowered = tmp / (src_stem + ".lowered.mir")
        asm = tmp / (src_stem + ".s")
        run(regalloc_cmd("llc", str(mir), str(lowered), target_flags=LLC_TARGET_FLAGS), debug=debug)
        run(emit_asm_cmd("llc", str(lowered), str(asm), target_flags=LLC_TARGET_FLAGS), debug=debug)
        return asm.read_bytes()


def finish_asm(asm: bytes, src_stem: str, dst: Path | None, emit: str, debug: bool = False) -> None:
    if emit == "assembly":
        write_output(asm, dst)
        return
    with tempfile.TemporaryDirectory(delete=not debug) as tmpdir:
        path = Path(tmpdir) / (src_stem + ".s")
        path.write_bytes(asm)
        cmd = ["clang", *CLANG_TARGET_FLAGS, "-c" if emit == "object" else "-fuse-ld=lld",
               str(path), "-o", "-" if dst is None else str(dst)]
        output = run(cmd, debug=debug)
        if dst is None:
            sys.stdout.buffer.write(output)


def finish_llvm_ir(llvm_ir: bytes, dst: Path | None, emit: str, debug: bool = False) -> None:
    with tempfile.TemporaryDirectory(delete = not debug) as tmpdir:
        path = Path(tmpdir) / "input.ll"
        # The MLIR round trip doesn't preserve the datalayout, so drop it and
        # let clang derive it from the triple.
        path.write_bytes(re.sub(rb"(?m)^target datalayout = .*\n", b"", llvm_ir))
        cmd = ["clang", *CLANG_TARGET_FLAGS]
        if emit == "object":
            cmd.append("-c")
        elif emit == "assembly":
            cmd.append("-S")
        else:
            cmd.append("-fuse-ld=lld")
        cmd.extend([str(path), "-o", "-" if dst is None else str(dst)])
        output = run(cmd, debug=debug)
        if dst is None:
            sys.stdout.buffer.write(output)


def optimize_from_levels(levels: list[str] | None) -> bool:
    if levels is None:
        return False
    return levels[-1] != "0"


def parse_opt_level(level: str) -> str:
    if not level.isdigit():
        raise argparse.ArgumentTypeError("optimization level must be a nonnegative integer")
    return level


def normalize_args(argv: list[str]) -> list[str]:
    result: list[str] = []
    for arg in argv:
        if arg == "-O":
            result.extend(["--opt-level", "1"])
        elif arg.startswith("-O") and arg[2:].isdigit():
            result.extend(["--opt-level", arg[2:]])
        else:
            result.append(arg)
    return result


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="vcc",
        usage="vcc [-h] [-o OUTPUT] [-c | -S | --emit-mlir | --emit-llvm] [-O[N]] [--llvm-backend] source [--debug]",
        description="Compile a C file via VeIR.",
    )
    parser.add_argument("source", type=Path, help="C source file")
    parser.add_argument(
        "-o", "--output",
        help="output path, or - for stdout with non-executable outputs (default: a.out)",
    )
    emit = parser.add_mutually_exclusive_group()
    emit.add_argument(
        "-c", action="store_const", const="object", dest="emit",
        help="emit an object file instead of an executable",
    )
    emit.add_argument(
        "-S", action="store_const", const="assembly", dest="emit",
        help="emit assembly instead of an executable",
    )
    emit.add_argument(
        "--emit-mlir", action="store_const", const="mlir", dest="emit",
        help="emit MLIR instead of an executable",
    )
    emit.add_argument(
        "--emit-llvm", action="store_const", const="llvm", dest="emit",
        help="emit LLVM IR instead of an executable",
    )
    parser.add_argument(
        "--llvm-O2", dest="llvm_o2", action="store_true",
        help="run the full LLVM middle-end (opt -O2) pipeline before mlir-translate",
    )
    parser.add_argument(
        "--llvm-backend", action="store_true",
        help="generate code with LLVM's RISC-V backend instead of VeIR's",
    )
    parser.add_argument(
        "--opt-level", dest="opt_levels", action="append",
        type=parse_opt_level, metavar="N",
        help=argparse.SUPPRESS,
    )

    parser.add_argument(
        "--no-build", action="store_true",
        help="use VeIR's executables as they are instead of running lake build first",
    )
    parser.add_argument(
        "--veir-stats", type=Path, metavar="FILE",
        help="append the input size in bytes, the seconds taken, and the name of each "
             "command that runs a VeIR executable to FILE, separated by tabs",
    )
    parser.add_argument(
        "--debug", action="store_true",
        help="keep tmp files; print commands to stderr",
    )

    parser.epilog = "-O0 disables VeIR optimization; -O and other numeric -O levels run the same optimizer."
    parser.set_defaults(emit="executable", debug=False)
    args = parser.parse_args(normalize_args(sys.argv[1:]))
    global VEIR_STATS
    VEIR_STATS = args.veir_stats

    if not args.source.is_file():
        sys.exit(f"vcc: source file not found: {args.source}")

    veir_backend = not args.llvm_backend and args.emit not in ("mlir", "llvm")
    check_tools(BASE_TOOLS + (() if args.no_build else VEIR_TOOLS)
                + (VEIR_BACKEND_TOOLS if veir_backend else ())
                + (("ld.lld",) if args.emit == "executable" else ()))
    # Linking always needs the riscv64 C library, so fail before compiling
    # rather than after. Other outputs may not need a sysroot at all; run()
    # adds the hint if clang fails for them.
    if args.emit == "executable" and not riscv_sysroot_found():
        sys.exit(MISSING_SYSROOT_HINT.strip())

    if args.output == "-":
        if args.emit == "executable":
            sys.exit("vcc: cannot write an executable to stdout")
        dst = None
    elif args.output is not None:
        dst = Path(args.output)
    elif args.emit == "object":
        dst = Path(args.source.stem + ".o")
    elif args.emit == "assembly":
        dst = Path(args.source.stem + ".s")
    elif args.emit == "mlir":
        dst = Path(args.source.stem + ".mlir")
    elif args.emit == "llvm":
        dst = Path(args.source.stem + ".ll")
    else:
        dst = Path("a.out")

    if not args.no_build:
        build_veir_tools(("veir-opt", "veir2mir") if veir_backend else ("veir-opt",))

    mlir = compile_to_mlir(args.source, optimize_from_levels(args.opt_levels), args.llvm_o2, debug=args.debug)
    if args.emit == "mlir":
        write_output(mlir, dst)
        return

    if args.emit == "llvm" or args.llvm_backend:
        llvm_ir = translate_mlir_to_llvm(mlir, args.source.stem, debug=args.debug)
        if args.emit == "llvm":
            write_output(llvm_ir, dst)
        else:
            finish_llvm_ir(llvm_ir, dst, args.emit, debug=args.debug)
        return

    asm = veir_backend_to_asm(mlir, args.source.stem, debug=args.debug)
    finish_asm(asm, args.source.stem, dst, args.emit, debug=args.debug)


if __name__ == "__main__":
    main()
