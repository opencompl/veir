#!/usr/bin/env python3
"""Differentially test vcc on random C programs generated by yarpgen.

Usage: run-yarpgen [-n COUNT] [--seed SEED] [--timeout SECONDS] [--save-temps] [-v] [vcc options]

Each test builds the whole program with clang as a reference, then builds two
versions of it whose func.c is compiled by vcc and whose driver.c is compiled by
clang: O0 uses clang's unoptimized output, and O2 runs LLVM's middle end first
(vcc --llvm-O2). Both versions must print the same output as the reference.
A version fails as vcc (compile error), link, crash, timeout, or mismatch; a
failure of the O0 version does not stop the O2 version from being tried. A failure
to build or run the clang reference is reported as reference. The working
directory of a failed test is kept and its path is printed. The exit status is
nonzero if any test failed.

vcc always runs without VeIR's middle-end optimizations and generates code with
VeIR's RISC-V backend, so -O levels, --llvm-O2, and --llvm-backend are rejected.
With --save-temps, the working directories of passing tests are kept too. With
-v, each command is printed before it runs, and each test program's output is
printed after it finishes.

The yarpgen binary is taken from $YARPGEN (default: ~/yarpgen/yarpgen).
"""

import argparse
import importlib.machinery
import importlib.util
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from collections import Counter
from pathlib import Path

VCC = Path(__file__).resolve().parent / "vcc"
YARPGEN = os.environ.get("YARPGEN", str(Path.home() / "yarpgen" / "yarpgen"))


def load_vcc():
    """Import vcc, whose file name has no .py suffix, to share its clang flags."""
    loader = importlib.machinery.SourceFileLoader("vcc", str(VCC))
    spec = importlib.util.spec_from_loader("vcc", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


CLANG = ["clang", *load_vcc().CLANG_TARGET_FLAGS, "-w"]
VERBOSE = False
# The vcc flags of each version under test.
VERSIONS = {"O0": [], "O2": ["--llvm-O2"]}


class TestFailure(Exception):
    def __init__(self, kind: str, detail: str) -> None:
        super().__init__(detail)
        self.kind = kind


def run(cmd: list[str], cwd: Path, timeout: float | None = None) -> subprocess.CompletedProcess:
    """Run a command with no stdin and captured output, printing it first if verbose."""
    if VERBOSE:
        print(f"+ (cd {shlex.quote(str(cwd))} && {shlex.join(cmd)})", flush=True)
    return subprocess.run(cmd, cwd=cwd, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                          timeout=timeout)


def build(kind: str, cmd: list[str], cwd: Path) -> str:
    """Run a generator or compiler command, returning its stdout."""
    result = run(cmd, cwd)
    if result.returncode != 0:
        raise TestFailure(kind, f"{' '.join(cmd)}\n{result.stderr}")
    return result.stdout


def execute(kind: str, exe: str, cwd: Path, timeout: float) -> str:
    """Run a test program, returning its stdout."""
    try:
        result = run([f"./{exe}"], cwd, timeout)
    except subprocess.TimeoutExpired:
        raise TestFailure("timeout" if kind == "crash" else kind,
                          f"{exe} timed out after {timeout}s") from None
    if VERBOSE:
        print(f"{exe} output: {result.stdout.strip()}", flush=True)
    if result.returncode != 0:
        raise TestFailure(kind, f"{exe} exited with status {result.returncode}\n{result.stderr}")
    return result.stdout


def generate(seed: str | None, tmp: Path) -> str:
    """Generate a C11 program in `tmp`, returning its seed."""
    cmd = [YARPGEN, "--std=c11", "-d", str(tmp)]
    if seed is not None:
        cmd += ["-s", seed]
    match = re.search(r"SEED (\S+?)\*/", build("yarpgen", cmd, tmp))
    return match.group(1) if match else (seed or "unknown")


def run_reference(tmp: Path, timeout: float) -> str:
    """Build the clang reference and driver.o in `tmp`, returning the expected output."""
    build("reference", [*CLANG, "-O2", "-fuse-ld=lld", "func.c", "driver.c", "-o", "reference"], tmp)
    build("reference", [*CLANG, "-O2", "-c", "driver.c", "-o", "driver.o"], tmp)
    return execute("reference", "reference", tmp, timeout)


def run_version(tmp: Path, name: str, vcc_args: list[str], expected: str, timeout: float) -> None:
    """Build one version of the program in `tmp` and compare its output to `expected`."""
    obj, exe = f"func-{name}.o", f"test-{name}"
    build("vcc", [sys.executable, str(VCC), *vcc_args, "-c", "func.c", "-o", obj], tmp)
    build("link", [*CLANG, "-fuse-ld=lld", obj, "driver.o", "-o", exe], tmp)
    actual = execute("crash", exe, tmp, timeout)
    if actual != expected:
        raise TestFailure("mismatch", f"vcc: {actual.strip()}\nclang: {expected.strip()}")


def main() -> int:
    parser = argparse.ArgumentParser(description="Differentially test vcc using yarpgen.",
                                     allow_abbrev=False)
    parser.add_argument("-n", "--count", type=int, default=1, help="number of tests to run")
    parser.add_argument("--seed", help="yarpgen seed to reproduce; requires a count of 1")
    parser.add_argument("--timeout", type=float, default=60,
                        help="time limit for running each program, in seconds")
    parser.add_argument("--save-temps", action="store_true",
                        help="keep the working directories of passing tests")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="print each command before running it")
    args, extra = parser.parse_known_args()
    global VERBOSE
    VERBOSE = args.verbose
    if args.seed is not None and args.count != 1:
        parser.error("--seed requires a count of 1")
    # VERSIONS fixes the pipeline; vcc's default is no VeIR optimization.
    for arg in extra:
        if re.fullmatch(r"-O\d*", arg) or arg in ("--opt-level", "--llvm-O2", "--llvm-backend"):
            parser.error(f"{arg} is not allowed: run-yarpgen chooses vcc's pipeline")

    failures: Counter[str] = Counter()
    passed = 0
    for i in range(1, args.count + 1):
        tmp = Path(tempfile.mkdtemp(prefix="yarpgen-vcc-"))
        seed = args.seed or "unknown"
        prefix = f"[{i}/{args.count}] seed"
        ok = True
        try:
            seed = generate(args.seed, tmp)
            expected = run_reference(tmp, args.timeout)
            for name, flags in VERSIONS.items():
                try:
                    run_version(tmp, name, [*flags, *extra], expected, args.timeout)
                except TestFailure as e:
                    ok = False
                    failures[f"{name} {e.kind}"] += 1
                    print(f"{prefix} {seed}: FAIL ({name} {e.kind})\n{e}", flush=True)
        except TestFailure as e:
            ok = False
            failures[e.kind] += 1
            print(f"{prefix} {seed}: FAIL ({e.kind})\n{e}", flush=True)
        if ok:
            passed += 1
            print(f"{prefix} {seed}: ok {expected.strip()}", flush=True)
        if args.save_temps or not ok:
            print(f"  kept {tmp}", flush=True)
        else:
            shutil.rmtree(tmp)

    summary = ", ".join(f"{count} {kind}" for kind, count in sorted(failures.items()))
    print(f"{passed}/{args.count} passed" + (f" ({summary})" if failures else ""))
    return 0 if passed == args.count else 1


if __name__ == "__main__":
    sys.exit(main())
