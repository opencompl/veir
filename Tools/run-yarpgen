#!/usr/bin/env python3
"""Differentially test vcc on random C programs generated by yarpgen.

Usage: run-yarpgen [--iterations N] [--seed SEED] [--timeout SECONDS] [--save-temps] [-v] [vcc options]

Tests run in parallel, one per core; 100 are run by default. Every line of output
starts with the number of the test it belongs to.

Each test builds the whole program with clang as a reference, then builds two
versions of it whose func.c is compiled by vcc and whose driver.c is compiled by
clang: O0 uses clang's unoptimized output, and O2 runs LLVM's middle end first
(vcc --llvm-O2). Both versions must print the same output as the reference.
A version fails as vcc (compile error), link, crash, timeout, or mismatch; a
failure of the O0 version does not stop the O2 version from being tried. A failure
to build or run the clang reference is reported as reference. The working
directory of a failed test is kept and its path is printed.

A mismatch stops the whole run at once, killing the tests in progress, with exit
status 2. All other failures are tallied, and the run ends with a table of them;
the exit status is then 1 if any test failed and 0 otherwise.

vcc always runs without VeIR's middle-end optimizations and generates code with
VeIR's RISC-V backend, so -O levels, --llvm-O2, and --llvm-backend are rejected.
With --save-temps, the working directories of passing tests are kept too. With
-v, each command is printed before it runs, and each test program's output is
printed after it finishes.

The yarpgen binary is taken from $YARPGEN (default: ~/yarpgen/yarpgen).
"""

import argparse
import concurrent.futures
import importlib.machinery
import importlib.util
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import threading
from collections import Counter
from pathlib import Path

VCC = Path(__file__).resolve().parent / "vcc"
YARPGEN = os.environ.get("YARPGEN", str(Path.home() / "yarpgen" / "yarpgen"))


def load_vcc():
    """Import vcc, whose file name has no .py suffix, to share its clang flags."""
    loader = importlib.machinery.SourceFileLoader("vcc", str(VCC))
    spec = importlib.util.spec_from_loader("vcc", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


CLANG = ["clang", *load_vcc().CLANG_TARGET_FLAGS, "-w"]
VERBOSE = False
DEFAULT_ITERATIONS = 100
# Each worker thread records here the label of the test it is running.
CURRENT_TEST = threading.local()
# Guards all of the following, as well as printing and starting subprocesses.
LOCK = threading.Lock()
CHILDREN: set[subprocess.Popen] = set()
COMPLETED = 0
PASSED: Counter[str] = Counter()  # Tests by version; "all" counts fully passing tests.
FAILURES: Counter[tuple[str, str, str]] = Counter()  # By (version, kind, error).
# The vcc flags of each version under test.
VERSIONS = {"O0": [], "O2": ["--llvm-O2"]}


def log(message: str) -> None:
    """Print a message, labeled with the current test, without interleaving."""
    with LOCK:
        print(f"{CURRENT_TEST.label} {message}", flush=True)


class TestFailure(Exception):
    def __init__(self, kind: str, detail: str, error: str) -> None:
        super().__init__(detail)
        self.kind = kind
        self.error = error  # A one-line description shared by similar failures.


def error_line(stderr: str) -> str:
    """Reduce compiler output to one line that doesn't vary between programs."""
    lines = [line.strip() for line in stderr.splitlines() if line.strip()]
    errors = [line for line in lines if "error" in line.lower()]
    line = next(iter(errors or reversed(lines)), "no error message")
    line = re.sub(r"function @\S+: ", "", line)
    return re.sub(r"\b\d+\b", "N", line)


def run(cmd: list[str], cwd: Path, timeout: float | None = None) -> subprocess.CompletedProcess:
    """Run a command with no stdin and captured output, printing it first if verbose."""
    if VERBOSE:
        log(f"+ (cd {shlex.quote(str(cwd))} && {shlex.join(cmd)})")
    with LOCK:
        proc = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True)
        CHILDREN.add(proc)
    try:
        stdout, stderr = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.communicate()
        raise
    finally:
        with LOCK:
            CHILDREN.discard(proc)
    return subprocess.CompletedProcess(cmd, proc.returncode, stdout, stderr)


def build(kind: str, cmd: list[str], cwd: Path) -> str:
    """Run a generator or compiler command, returning its stdout."""
    result = run(cmd, cwd)
    if result.returncode != 0:
        raise TestFailure(kind, f"{' '.join(cmd)}\n{result.stderr}", error_line(result.stderr))
    return result.stdout


def execute(kind: str, exe: str, cwd: Path, timeout: float) -> str:
    """Run a test program, returning its stdout."""
    try:
        result = run([f"./{exe}"], cwd, timeout)
    except subprocess.TimeoutExpired:
        raise TestFailure("timeout" if kind == "crash" else kind,
                          f"{exe} timed out after {timeout}s", "timed out") from None
    if VERBOSE:
        log(f"{exe} output: {result.stdout.strip()}")
    if result.returncode != 0:
        raise TestFailure(kind, f"{exe} exited with status {result.returncode}\n{result.stderr}",
                          f"exited with status {result.returncode}")
    return result.stdout


def generate(seed: str | None, tmp: Path) -> str:
    """Generate a C11 program in `tmp`, returning its seed."""
    cmd = [YARPGEN, "--std=c11", "-d", str(tmp)]
    if seed is not None:
        cmd += ["-s", seed]
    match = re.search(r"SEED (\S+?)\*/", build("yarpgen", cmd, tmp))
    return match.group(1) if match else (seed or "unknown")


def run_reference(tmp: Path, timeout: float) -> str:
    """Build the clang reference and driver.o in `tmp`, returning the expected output."""
    build("reference", [*CLANG, "-O2", "-fuse-ld=lld", "func.c", "driver.c", "-o", "reference"], tmp)
    build("reference", [*CLANG, "-O2", "-c", "driver.c", "-o", "driver.o"], tmp)
    return execute("reference", "reference", tmp, timeout)


def run_version(tmp: Path, name: str, vcc_args: list[str], expected: str, timeout: float) -> None:
    """Build one version of the program in `tmp` and compare its output to `expected`."""
    obj, exe = f"func-{name}.o", f"test-{name}"
    build("vcc", [sys.executable, str(VCC), *vcc_args, "-c", "func.c", "-o", obj], tmp)
    build("link", [*CLANG, "-fuse-ld=lld", obj, "driver.o", "-o", exe], tmp)
    actual = execute("crash", exe, tmp, timeout)
    if actual != expected:
        raise TestFailure("mismatch", f"vcc:   {actual.strip()}\nclang: {expected.strip()}",
                          "output differs from clang")


def print_stats() -> None:
    """Print a summary of the tests completed so far."""
    print(f"\n{PASSED['all']}/{COMPLETED} tests passed "
          f"({', '.join(f'{name}: {PASSED[name]}' for name in VERSIONS)})")
    if FAILURES:
        print(f"\n{'Count':>5}  {'Version':<7}  {'Kind':<9}  Error")
        for (version, kind, error), count in FAILURES.most_common():
            print(f"{count:>5}  {version:<7}  {kind:<9}  {error}")
    sys.stdout.flush()


def stop_on_mismatch(seed: str, name: str, failure: TestFailure, tmp: Path) -> None:
    """Report a mismatch and exit at once, killing the tests in progress."""
    # LOCK is never released, so no other test can print or start a subprocess.
    LOCK.acquire()
    for proc in CHILDREN:
        proc.kill()
    print_stats()
    print(f"\nMISMATCH: the {name} version of seed {seed} printed the wrong output, stopping.\n"
          f"{failure}\n"
          f"Working directory: {tmp}\n"
          f"To reproduce: {sys.argv[0]} --seed {seed}", flush=True)
    os._exit(2)


def run_iteration(i: int, iterations: int, args: argparse.Namespace,
                  vcc_args: list[str]) -> None:
    """Run test number `i`, recording its results."""
    global COMPLETED
    CURRENT_TEST.label = f"[{i}/{iterations}]"
    tmp = Path(tempfile.mkdtemp(prefix="yarpgen-vcc-"))
    seed = args.seed or "unknown"
    ok = True

    def fail(version: str, e: TestFailure) -> None:
        nonlocal ok
        ok = False
        with LOCK:
            FAILURES[(version, e.kind, e.error)] += 1
        log(f"seed {seed}: FAIL ({e.kind if version == '-' else f'{version} {e.kind}'})\n{e}")

    try:
        seed = generate(args.seed, tmp)
        expected = run_reference(tmp, args.timeout)
        for name, flags in VERSIONS.items():
            try:
                run_version(tmp, name, [*flags, *vcc_args], expected, args.timeout)
                with LOCK:
                    PASSED[name] += 1
            except TestFailure as e:
                if e.kind == "mismatch":
                    stop_on_mismatch(seed, name, e, tmp)
                fail(name, e)
    except TestFailure as e:
        fail("-", e)
    if ok:
        log(f"seed {seed}: ok {expected.strip()}")
    if args.save_temps or not ok:
        log(f"kept {tmp}")
    else:
        shutil.rmtree(tmp)
    with LOCK:
        COMPLETED += 1
        PASSED["all"] += ok


def main() -> int:
    parser = argparse.ArgumentParser(description="Differentially test vcc using yarpgen.",
                                     allow_abbrev=False)
    parser.add_argument("-n", "--iterations", type=int,
                        help=f"number of tests to run (default: {DEFAULT_ITERATIONS}, "
                             "or 1 with --seed)")
    parser.add_argument("--seed", help="yarpgen seed to reproduce; runs a single test")
    parser.add_argument("--timeout", type=float, default=60,
                        help="time limit for running each program, in seconds")
    parser.add_argument("--save-temps", action="store_true",
                        help="keep the working directories of passing tests")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="print each command before running it")
    args, extra = parser.parse_known_args()
    global VERBOSE
    VERBOSE = args.verbose
    if args.seed is not None and args.iterations not in (None, 1):
        parser.error("--seed requires a single iteration")
    iterations = args.iterations or (1 if args.seed is not None else DEFAULT_ITERATIONS)
    # VERSIONS fixes the pipeline; vcc's default is no VeIR optimization.
    for arg in extra:
        if re.fullmatch(r"-O\d*", arg) or arg in ("--opt-level", "--llvm-O2", "--llvm-backend"):
            parser.error(f"{arg} is not allowed: run-yarpgen chooses vcc's pipeline")

    # Threads are enough: all the real work happens in subprocesses.
    with concurrent.futures.ThreadPoolExecutor(max_workers=os.cpu_count()) as pool:
        try:
            list(pool.map(lambda i: run_iteration(i, iterations, args, extra),
                          range(1, iterations + 1)))
        except KeyboardInterrupt:
            pool.shutdown(wait=False, cancel_futures=True)
            raise

    print_stats()
    return 0 if PASSED["all"] == iterations else 1


if __name__ == "__main__":
    sys.exit(main())
