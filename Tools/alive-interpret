#!/usr/bin/env python3
"""Run a VeIR interpreter test under alive-exec.

The module is translated to LLVM IR with ``Tools/veir2llvm``, executed by
Alive2's ``alive-exec``, and the verdict is printed in the shape
``veir-interpret`` prints, so a lit test can hold both to the same CHECK
lines.
"""

import re
import subprocess
import sys
import tempfile
from importlib.machinery import SourceFileLoader
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
vsmith = SourceFileLoader("vsmith", str(TOOLS / "vsmith")).load_module()


def main(argv: list[str]) -> int:
    if len(argv) != 1:
        print("usage: alive-interpret <test.mlir>", file=sys.stderr)
        return 1
    translated = subprocess.run(
        [sys.executable, str(TOOLS / "veir2llvm"), argv[0]],
        capture_output=True, text=True)
    if translated.returncode != 0:
        sys.stderr.write(translated.stderr)
        return 1
    # Without this alive-exec runs the `main` wrapper that llubi insists on,
    # and reports its result instead of the test's.
    func = ["--func=veir_test_main"] if "@veir_test_main(" in translated.stdout else []
    entry = "veir_test_main" if func else "main"
    declared = re.search(rf"^define (.+?) @{entry}\(", translated.stdout, re.M)
    return_type = declared.group(1) if declared else None
    with tempfile.TemporaryDirectory() as tmp:
        ll_path = Path(tmp) / "test.ll"
        ll_path.write_text(translated.stdout)
        # The default 10s SMT timeout flakes when lit runs many solvers at once.
        result = subprocess.run(["alive-exec", "--smt-to=300000", *func, str(ll_path)],
                                capture_output=True, text=True)
    log = result.stdout + result.stderr
    try:
        verdict, _ = vsmith.classify_alive_exec_output(log, return_type)
    except ValueError as e:
        sys.stderr.write(str(e))
        return 1
    print(verdict)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
